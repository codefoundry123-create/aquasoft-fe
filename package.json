{
  "name": "daily-hydration-reminder",
  "version": "1.1.110",
  "versionCode": 110,
  "description": "Our app helps you track your water intake, sends smart reminders, and ensures you meet your daily hydration goals. With an easy-to-use interface, customizable alerts, and insightful stats, staying healthy has never been easier. Drink water, stay refreshed",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build -c production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy:policy": "surge ./policies/privacy-policy app-privacy-policy.surge.sh",
    "and": "npm run build && npx cap sync android && npx cap copy android && npx cap open android",
    "android:prod": "npm run build:prod && npx cap sync android && npx cap copy android && npx cap open android",
    "ios": "npm run build:prod && npx cap sync ios && npx cap open ios"
  },
  "private": true,
