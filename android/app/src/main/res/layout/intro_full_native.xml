<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/native_ad_view_full"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#B8B4B4">

  <RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Top bar with Close (X) and Info -->
    <RelativeLayout
      android:id="@+id/top_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentTop="true"
      android:background="#000000"
      android:padding="15dp">

      <ImageView
        android:id="@+id/ad_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:background="@drawable/rounded_button"

        android:src="@android:drawable/ic_menu_close_clear_cancel" />

    </RelativeLayout>
    <!-- Media Content (fills remaining space above bottom card) -->
    <com.google.android.gms.ads.nativead.MediaView
      android:id="@+id/ad_media"
      android:layout_width="match_parent"
      android:layout_height="409dp"
      android:layout_above="@id/bottom_card"
      android:layout_below="@id/top_bar"
      android:adjustViewBounds="true"
      android:background="#000000"
      android:scaleType="fitCenter" />
    <!-- Bottom Section (Gray Card) -->
    <LinearLayout
      android:id="@+id/bottom_card"
      android:layout_width="match_parent"
      android:layout_height="200dp"
      android:layout_alignParentBottom="true"
      android:background="#EEEEEE"
      android:orientation="vertical"
      android:padding="12dp">
      <!-- Icon + Title + Rating -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/ad_app_icon"
          android:layout_width="70dp"
          android:layout_height="70dp"
          android:layout_marginEnd="8dp" />

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:orientation="vertical">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
              android:layout_width="28dp"
              android:layout_height="25dp"
              android:layout_marginRight="7dp"
              android:background="#094DBA"
              android:gravity="center"
              android:text="AD"
              android:textColor="#F2F2F2"
              android:textSize="12sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/ad_headline"
              android:layout_width="match_parent"
              android:layout_height="25dp"
              android:ellipsize="end"
              android:singleLine="true"
              android:textColor="#000000"
              android:textSize="16sp"
              android:textStyle="bold" />
          </LinearLayout>

          <!-- Rating stars -->

          <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#555555"
            android:textSize="14sp" />
        </LinearLayout>
      </LinearLayout>
      <!-- Ad body -->

      <!-- CTA Button -->

      <Button
        android:id="@+id/ad_call_to_action"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_button"
        android:backgroundTint="#3e44b6"
        android:textAllCaps="true"
        android:text="cta"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
    </LinearLayout>
  </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
